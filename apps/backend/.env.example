# ============================================================
# TRAÇO CIVIL — Backend Java Spring Boot (variáveis de ambiente)
# ============================================================
# Copie este arquivo para .env (ou defina as variáveis no seu provedor de deploy)
# e preencha os valores reais. NUNCA commite o .env preenchido.
#
# Legenda:
#   [OBRIGATÓRIO em produção]  — sem esse valor o sistema não deve subir
#   [OPCIONAL]                 — tem fallback seguro para dev local
#   [DEV-ONLY]                 — usar apenas em desenvolvimento local

# --- Banco de dados ---
# [OBRIGATÓRIO em produção] Postgres gerenciado (Render/Railway/Fly.io/Supabase)
DATABASE_URL=jdbc:postgresql://host:5432/tracocivil
DATABASE_USERNAME=tracocivil
# [OBRIGATÓRIO em produção] Gere com: openssl rand -base64 24
DATABASE_PASSWORD=TROCAR_PARA_SENHA_FORTE_MINIMO_24_BYTES

# --- JWT (segurança de autenticação) ---
# [OBRIGATÓRIO em produção] Mínimo 32 bytes. Gere com: openssl rand -base64 48
# Se ausente, o backend usa um fallback de DEV que é rejeitado em prod.
JWT_SECRET=TROCAR_PARA_SECRETO_FORTE_MINIMO_32_BYTES

# --- Worker de IA (Python, packages/ai) ---
# [OPCIONAL] URL interna do worker. Em prod, aponte para a rede privada.
AI_SERVICE_URL=http://127.0.0.1:8001
# [OBRIGATÓRIO em produção se o worker estiver ativo] Token interno compartilhado
# com o worker Python. Gere com: openssl rand -hex 32 e use o MESMO valor no
# packages/ai/.env (WORKER_TOKEN). Impede chamadas externas diretas ao worker.
WORKER_TOKEN=TROCAR_PARA_TOKEN_COMPARTILHADO_COM_WORKER

# --- CORS (origens permitidas do frontend) ---
# [OBRIGATÓRIO em produção] Lista separada por vírgulas. Nunca use * em prod.
CORS_ORIGINS=https://seu-dominio.vercel.app,http://localhost:3000

# --- Perfil Spring ---
# [OPCIONAL] 'prod' ativa application-prod.properties (Postgres, Flyway, H2 off)
# SPRING_PROFILES_ACTIVE=prod