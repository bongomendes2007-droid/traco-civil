# TRAÇO Backend Configuration

# CORS - Origens permitidas (frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# Diretório de uploads (relativo ao backend)
UPLOAD_DIR=uploads

# Diretório de projetos (relativo ao backend)
PROJECTS_DIR=projects

# Tamanho máximo de arquivo em bytes (padrão: 100MB)
MAX_FILE_SIZE=104857600

# Porta do servidor
PORT=8000

# Ambiente (development, production, test)
ENV=development