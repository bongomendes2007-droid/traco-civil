{
  "buildCommand": "pip install -r backend/requirements.txt",
  "outputDirectory": "frontend",
  "devCommand": "python backend/main.py",
  "framework": "fastapi",
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}